<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!--
    Installs for the current user by default (no administrator rights needed), into
    %LocalAppData%\Programs\实验排班生成器, with Start menu and desktop shortcuts.
  -->
  <Package
      Name="$(ProductTitle)"
      Manufacturer="arcxya09"
      Version="$(ProductVersion)"
      UpgradeCode="$(UpgradeCode)"
      Language="2052"
      Codepage="65001"
      Scope="perUserOrMachine">

    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的$(ProductTitle)。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/arcxya09/lab_scheduling" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(ProductTitle)" />
    </StandardDirectory>

    <!-- Updates go back into the folder the user picked last time. -->
    <Property Id="PREVIOUSINSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="$(AppRegistryKey)" Name="InstallFolder" Type="raw" />
    </Property>
    <SetDirectory Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" Condition="PREVIOUSINSTALLFOLDER" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuShortcut" Name="$(ProductTitle)" Target="[INSTALLFOLDER]LabSchedule.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="$(AppRegistryKey)" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <!-- Lets the app tell an installed copy (updates via MSI) from a portable one. -->
        <RegistryValue Root="HKCU" Key="$(AppRegistryKey)" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopShortcut" Name="$(ProductTitle)" Target="[INSTALLFOLDER]LabSchedule.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="$(AppRegistryKey)" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="$(ProductTitle)">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <!-- Skip the licence page: go straight from the welcome page to the folder choice. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
    </UI>
  </Package>
</Wix>
