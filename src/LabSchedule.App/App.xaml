<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LabSchedule.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Calendar colours. Read from code (Timeline/TimelineBrushes.cs), keyed by theme. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="TimelineCanvasBackground">#80F6F6F6</Color>
                    <Color x:Key="MovePreviewText">#FF0B3F3A</Color>
                    <Color x:Key="TimelineHeaderBackground">#FF223033</Color>
                    <Color x:Key="TimelineHeaderForeground">#FFFFFFFF</Color>
                    <Color x:Key="TimelineHeaderDivider">#24FFFFFF</Color>
                    <Color x:Key="TimelineMonthBackground">#FFF9FBF8</Color>
                    <Color x:Key="TimelineMonthForeground">#FF223033</Color>
                    <Color x:Key="TimelineTrackBackground">#FFF7FAF8</Color>
                    <Color x:Key="TimelineInvalidDay">#FFEDF0F0</Color>
                    <Color x:Key="TimelineWeekend">#FFECF4F1</Color>
                    <Color x:Key="TimelineDayLine">#24172022</Color>
                    <Color x:Key="TimelineBorder">#FFCBD7D7</Color>
                    <Color x:Key="TimelineSurface">#FFFFFFFF</Color>
                    <Color x:Key="ListHeaderBackground">#FF223033</Color>
                    <Color x:Key="ListHeaderForeground">#FFFFFFFF</Color>
                    <Color x:Key="DragTooltipBackground">#F5172022</Color>
                    <Color x:Key="DragTooltipForeground">#FFFFFFFF</Color>
                    <Color x:Key="ResizePreviewFill">#33D97706</Color>
                    <Color x:Key="ResizePreviewStroke">#DBD97706</Color>
                    <Color x:Key="ResizePreviewText">#FF6B3D00</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="TimelineCanvasBackground">#08FFFFFF</Color>
                    <Color x:Key="MovePreviewText">#FFC8F5EF</Color>
                    <Color x:Key="TimelineHeaderBackground">#FF1B2527</Color>
                    <Color x:Key="TimelineHeaderForeground">#FFE6EEEE</Color>
                    <Color x:Key="TimelineHeaderDivider">#1FFFFFFF</Color>
                    <Color x:Key="TimelineMonthBackground">#FF262E30</Color>
                    <Color x:Key="TimelineMonthForeground">#FFE2EAEA</Color>
                    <Color x:Key="TimelineTrackBackground">#FF1F2628</Color>
                    <Color x:Key="TimelineInvalidDay">#FF2C3335</Color>
                    <Color x:Key="TimelineWeekend">#FF243032</Color>
                    <Color x:Key="TimelineDayLine">#24FFFFFF</Color>
                    <Color x:Key="TimelineBorder">#FF3A4446</Color>
                    <Color x:Key="TimelineSurface">#FF1F2628</Color>
                    <Color x:Key="ListHeaderBackground">#FF2A3436</Color>
                    <Color x:Key="ListHeaderForeground">#FFE6EEEE</Color>
                    <Color x:Key="DragTooltipBackground">#F5F2F5F5</Color>
                    <Color x:Key="DragTooltipForeground">#FF172022</Color>
                    <Color x:Key="ResizePreviewFill">#40F59E0B</Color>
                    <Color x:Key="ResizePreviewStroke">#E6F59E0B</Color>
                    <Color x:Key="ResizePreviewText">#FFFFE2B0</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="ListHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ListCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!-- Settings page cards, in the style of the Windows Settings app. -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="68" />
            </Style>

            <Style x:Key="SettingsSectionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,6" />
            </Style>

            <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Destructive button: the original "删除" button was red. -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
