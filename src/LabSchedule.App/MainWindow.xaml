<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LabSchedule.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LabSchedule"
    xmlns:timeline="using:LabSchedule.Timeline"
    xmlns:controls="using:LabSchedule.Controls"
    Title="实验排班生成器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hidden WebView2 host used to print PDFs, kept behind the workbench. -->
        <Grid
            x:Name="PrintHost"
            Grid.RowSpan="4"
            Width="1200"
            Height="900"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Opacity="0" />

        <!-- Title bar: app mark, name and the schedule summary. Caption buttons are drawn by Windows. -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <Image Width="20" Height="20" Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="实验排班生成器" />
                <TextBlock
                    x:Name="SummaryText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="加载中" />
            </StackPanel>
        </Grid>

        <!-- Application command bar -->
        <Grid x:Name="CommandArea" Grid.Row="1" Padding="8,0,16,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton x:Name="UndoButton" Click="UndoButton_Click" Label="撤销" ToolTipService.ToolTip="撤销 Ctrl+Z">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7A7;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RedoButton" Click="RedoButton_Click" Label="重做" ToolTipService.ToolTip="重做 Ctrl+Y">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7A6;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="ImportButton" Click="ImportButton_Click" Label="导入 JSON">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="SaveButton" Click="SaveButton_Click" Label="保存 JSON">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ExportButton" Click="ExportButton_Click" Label="导出 JSON">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xEDE1;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ShowFolderButton" Click="ShowFolderButton_Click" Label="打开输出目录">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarElementContainer VerticalAlignment="Center">
                    <Button
                        x:Name="GenerateButton"
                        AutomationProperties.Name="生成 PDF"
                        Margin="4,0,0,0"
                        Click="GenerateButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xEA90;" />
                            <TextBlock Text="生成 PDF" />
                        </StackPanel>
                    </Button>
                </AppBarElementContainer>
                <AppBarSeparator />
                <AppBarButton x:Name="SettingsButton" Click="SettingsButton_Click" Label="设置" ToolTipService.ToolTip="设置">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Border x:Name="DirtyBadge" Padding="10,3" VerticalAlignment="Center" CornerRadius="12">
                    <TextBlock x:Name="DirtyText" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" Text="未保存" />
                </Border>
                <TextBlock
                    x:Name="StatusText"
                    MinWidth="180"
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextAlignment="Right"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>

        <!-- "发现新版本" bar -->
        <InfoBar
            x:Name="UpdateBar"
            Grid.Row="2"
            Margin="8,0,8,8"
            CloseButtonClick="UpdateBar_CloseButtonClick"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateActionButton" Click="UpdateActionButton_Click" Content="立即更新" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <StackPanel Margin="0,0,0,12" Spacing="8">
                    <ProgressBar x:Name="UpdateProgress" Maximum="100" Visibility="Collapsed" />
                    <HyperlinkButton x:Name="UpdateNotesLink" Padding="0" Content="查看更新说明" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- Workbench -->
        <Grid x:Name="Workbench" Grid.Row="3" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="EditorColumn" Width="390" />
            </Grid.ColumnDefinitions>

            <!-- Drag to change the editor panel's width (MainWindow.Layout.cs). -->
            <controls:SplitterBar x:Name="EditorSplitter" Grid.Column="1" Orientation="Vertical" />

            <!-- Left: settings, toolbar, calendar and list -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <!--
                      The calendar and the list share the remaining height. Both rows are star-sized so
                      the list never gets pushed past the card's edge; the splitter between them changes
                      their proportions.
                    -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="TimelineRow" Height="2*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ListRow" Height="*" MinHeight="96" />
                    </Grid.RowDefinitions>

                    <Grid Padding="14" ColumnSpacing="10" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <NumberBox
                            x:Name="YearInput"
                            Header="年份"
                            GotFocus="HistoryField_GotFocus"
                            LostFocus="HistoryField_LostFocus"
                            Maximum="2200"
                            Minimum="1900"
                            SpinButtonPlacementMode="Compact"
                            ValidationMode="InvalidInputOverwritten"
                            ValueChanged="YearInput_ValueChanged" />
                        <TextBox
                            x:Name="TitleInput"
                            Grid.Column="1"
                            Header="标题"
                            GotFocus="HistoryField_GotFocus"
                            LostFocus="HistoryField_LostFocus"
                            TextChanged="ConfigText_TextChanged" />
                        <ComboBox
                            x:Name="PageSizeInput"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Header="页面"
                            SelectionChanged="ConfigCombo_SelectionChanged">
                            <ComboBoxItem Content="A4" Tag="A4" />
                            <ComboBoxItem Content="A3" Tag="A3" />
                        </ComboBox>
                        <ComboBox
                            x:Name="OrientationInput"
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            Header="方向"
                            SelectionChanged="ConfigCombo_SelectionChanged">
                            <ComboBoxItem Content="横向" Tag="landscape" />
                            <ComboBoxItem Content="纵向" Tag="portrait" />
                        </ComboBox>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="24">
                            <CheckBox x:Name="CascadeInput" Click="ConfigCheck_Click" Content="联动后续安排" />
                            <CheckBox x:Name="WeekendInput" Click="ConfigCheck_Click" Content="高亮周末" />
                            <CheckBox x:Name="MaintenanceListInput" Click="ConfigCheck_Click" Content="实验列表包含维护" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Padding="14,10"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddExperimentButton" AutomationProperties.Name="插入实验" Click="AddExperimentButton_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock Text="插入实验" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddMaintenanceButton" AutomationProperties.Name="插入维护" Click="AddMaintenanceButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock Text="插入维护" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteButton" AutomationProperties.Name="删除" Click="DeleteButton_Click" Style="{StaticResource DangerButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    <TextBlock Text="删除" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <timeline:TimelineView x:Name="TimelinePanel" Grid.Row="2" />

                    <!-- Item list -->
                    <controls:SplitterBar x:Name="ListSplitter" Grid.Row="3" Height="9" Orientation="Horizontal" />

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="ListHeader" Height="34" Padding="16,0,16,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="196" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ListHeader0" Style="{StaticResource ListHeaderTextStyle}" Text="颜色" />
                            <TextBlock x:Name="ListHeader1" Grid.Column="1" Style="{StaticResource ListHeaderTextStyle}" Text="编号" />
                            <TextBlock x:Name="ListHeader2" Grid.Column="2" Style="{StaticResource ListHeaderTextStyle}" Text="类型" />
                            <TextBlock x:Name="ListHeader3" Grid.Column="3" Style="{StaticResource ListHeaderTextStyle}" Text="名称" />
                            <TextBlock x:Name="ListHeader4" Grid.Column="4" Style="{StaticResource ListHeaderTextStyle}" Text="负责人" />
                            <TextBlock x:Name="ListHeader5" Grid.Column="5" Style="{StaticResource ListHeaderTextStyle}" Text="起止日期" />
                            <TextBlock x:Name="ListHeader6" Grid.Column="6" Style="{StaticResource ListHeaderTextStyle}" Text="时长" />
                        </Grid>
                        <ListView
                            x:Name="ItemList"
                            Grid.Row="1"
                            Padding="0,2,0,4"
                            SelectionChanged="ItemList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="36" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ItemRow">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="196" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="18"
                                            Height="12"
                                            HorizontalAlignment="Left"
                                            Background="{x:Bind Swatch, Mode=OneWay}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource ListCellTextStyle}" Text="{x:Bind Id, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource ListCellTextStyle}" Text="{x:Bind TypeText, Mode=OneWay}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource ListCellTextStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource ListCellTextStyle}" Text="{x:Bind Leader, Mode=OneWay}" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource ListCellTextStyle}" Text="{x:Bind DateRange, Mode=OneWay}" />
                                        <TextBlock Grid.Column="6" Style="{StaticResource ListCellTextStyle}" Text="{x:Bind Duration, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: activity editor and output paths -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer Padding="16,12,16,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Grid Padding="0,0,0,10" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0,0,0,2">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="活动编辑" />
                            <Button x:Name="DuplicateButton" AutomationProperties.Name="复制" HorizontalAlignment="Right" Click="DuplicateButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                    <TextBlock Text="复制" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本信息" />
                        <Grid ColumnSpacing="10" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ItemIdInput" Header="编号" IsReadOnly="True" />
                            <ComboBox
                                x:Name="ItemTypeInput"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="类型"
                                SelectionChanged="ItemTypeInput_SelectionChanged">
                                <ComboBoxItem Content="实验" Tag="experiment" />
                                <ComboBoxItem Content="维护" Tag="maintenance" />
                            </ComboBox>
                            <TextBox
                                x:Name="ItemNameInput"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Header="名称"
                                GotFocus="HistoryField_GotFocus"
                                LostFocus="HistoryField_LostFocus"
                                TextChanged="ItemText_TextChanged" />
                            <TextBox
                                x:Name="ItemLeaderInput"
                                Grid.Row="2"
                                Header="负责人"
                                GotFocus="HistoryField_GotFocus"
                                LostFocus="HistoryField_LostFocus"
                                TextChanged="ItemText_TextChanged" />
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="颜色" />
                                <DropDownButton x:Name="ItemColorButton" AutomationProperties.Name="颜色" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border
                                            x:Name="ItemColorSwatch"
                                            Width="22"
                                            Height="14"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                        <TextBlock x:Name="ItemColorText" FontFamily="Consolas" Text="#4E79A7" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <Flyout x:Name="ItemColorFlyout" Closed="ItemColorFlyout_Closed" Opening="ItemColorFlyout_Opening" Placement="BottomEdgeAlignedRight">
                                            <ColorPicker
                                                x:Name="ItemColorPicker"
                                                ColorChanged="ItemColorPicker_ColorChanged"
                                                ColorSpectrumShape="Box"
                                                IsAlphaEnabled="False"
                                                IsColorChannelTextInputVisible="False"
                                                IsColorSliderVisible="True"
                                                IsHexInputVisible="True"
                                                IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="时间安排" />
                        <Grid ColumnSpacing="10" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CalendarDatePicker
                                x:Name="ItemStartInput"
                                HorizontalAlignment="Stretch"
                                DateChanged="ItemDate_DateChanged"
                                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                Header="开始日期"
                                PlaceholderText="选择日期" />
                            <CalendarDatePicker
                                x:Name="ItemEndInput"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                DateChanged="ItemDate_DateChanged"
                                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                Header="结束日期"
                                PlaceholderText="选择日期" />
                            <TextBox x:Name="ItemDurationInput" Grid.Row="1" Header="时长" IsReadOnly="True" />
                            <TextBox
                                x:Name="ItemDescriptionInput"
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                MinHeight="74"
                                AcceptsReturn="True"
                                Header="备注"
                                GotFocus="HistoryField_GotFocus"
                                LostFocus="HistoryField_LostFocus"
                                TextChanged="ItemText_TextChanged"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Border Margin="0,6,0,0" Padding="0,12,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="输出" />
                                <TextBox
                                    x:Name="PdfPathInput"
                                    Header="PDF 输出路径"
                                    GotFocus="HistoryField_GotFocus"
                                    LostFocus="HistoryField_LostFocus"
                                    TextChanged="PathText_TextChanged" />
                                <TextBox
                                    x:Name="HtmlPathInput"
                                    Header="HTML 输出路径"
                                    GotFocus="HistoryField_GotFocus"
                                    LostFocus="HistoryField_LostFocus"
                                    TextChanged="PathText_TextChanged" />
                                <TextBox x:Name="JsonPathInput" Header="默认 JSON 路径" IsReadOnly="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Settings page; replaces the command bar and workbench while open. -->
        <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel MaxWidth="1000" Margin="32,4,32,32" Spacing="4">
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="SettingsBackButton"
                        AutomationProperties.Name="返回"
                        Click="SettingsBackButton_Click"
                        Style="{StaticResource NavigationBackButtonNormalStyle}"
                        ToolTipService.ToolTip="返回 (Esc)" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                </StackPanel>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="外观" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="应用主题" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="选择浅色或深色，或者跟随 Windows 的设置" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeSetting"
                            Grid.Column="2"
                            MinWidth="160"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="应用主题"
                            SelectionChanged="ThemeSetting_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="编辑" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8AB;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="默认开启“联动后续安排”" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="打开程序时该选项的初始状态。开启后，修改结束日期或插入安排时，后面的安排会一起平移" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="CascadeSetting"
                            Grid.Column="2"
                            MinWidth="0"
                            AutomationProperties.Name="默认开启联动后续安排"
                            OffContent="关"
                            OnContent="开"
                            Toggled="CascadeSetting_Toggled" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="文件" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="默认输出文件夹" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="“保存 JSON”写入这里的 default_schedule.json，启动时也从这里加载；新生成的 PDF/HTML 默认也放在这里" />
                            <TextBlock
                                x:Name="OutputDirText"
                                Margin="0,4,0,0"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ChangeOutputDirButton" Click="ChangeOutputDirButton_Click" Content="更改…" />
                            <Button x:Name="OpenOutputDirButton" Click="OpenOutputDirButton_Click" Content="打开" />
                            <Button x:Name="ResetOutputDirButton" Click="ResetOutputDirButton_Click" Content="恢复默认" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="更新" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE895;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="启动时自动检查更新" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="有新版本时在窗口顶部提示，确认后自动下载并安装" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="UpdateCheckSetting"
                            Grid.Column="2"
                            MinWidth="0"
                            AutomationProperties.Name="启动时自动检查更新"
                            OffContent="关"
                            OnContent="开"
                            Toggled="UpdateCheckSetting_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72C;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentVersionText" Text="当前版本" />
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingsDescriptionStyle}" Text="从 GitHub 获取最新版本信息" />
                        </StackPanel>
                        <Button x:Name="CheckUpdatesButton" Grid.Column="2" VerticalAlignment="Center" Click="CheckUpdatesButton_Click" Content="检查更新" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="关于" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="32" Height="32" Source="ms-appx:///Assets/AppIcon.png" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="实验排班生成器" />
                            <TextBlock x:Name="AboutText" Style="{StaticResource SettingsDescriptionStyle}" />
                        </StackPanel>
                        <HyperlinkButton
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="GitHub 项目主页"
                            NavigateUri="https://github.com/arcxya09/lab_scheduling" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Floating drag feedback (ghost bar and tooltip) is drawn here, above everything. -->
        <Canvas x:Name="OverlayCanvas" Grid.RowSpan="4" IsHitTestVisible="False" />
    </Grid>
</Window>
